{
    "name": "integration-test",
    "packageManager": "yarn@4.7.0",
    "scripts": {
        "node-build": "tsc && NODE_OPTIONS='--import tsx' qrill build",
        "node-dev": "tsc --watch & NODE_OPTIONS='--import tsx' qrill dev",

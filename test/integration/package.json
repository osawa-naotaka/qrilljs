        "dev": "tsc --watch & qrill dev",
        "check": "biome check --write ./site"
    },
    "dependencies": {
        "@biomejs/biome": "^1.9.4",
        "typescript": "^5.9.2",
        "qrill": "../../qrill-0.1.0-alpha.6.tgz"
    }
}

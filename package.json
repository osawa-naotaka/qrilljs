{
  "name": "qrilljs",
  "version": "0.1.0-alpha.44",
  "description": "lightweight static site generator for typescript",
  "type": "module",
  "main": "build/client/main.js",
  "exports": {
    "./bin": {
      "types": "./build/bin/main.d.ts",
      "import": "./build/bin/main.js",
      "require": "./build/bin/main.js"
    },
    "./core": {
      "types": "./build/core/main.d.ts",
      "import": "./build/core/main.js",
      "require": "./build/core/main.js"
    },
    "./server": {
      "types": "./build/server/main.d.ts",
      "import": "./build/server/main.js",
      "require": "./build/server/main.js"
    },
    "./jsx-runtime": {
      "types": "./build/jsx-runtime/main.d.ts",
      "import": "./build/jsx-runtime/main.js",
      "require": "./build/jsx-runtime/main.js"
    },
    "./jsx-dev-runtime": {
      "types": "./build/jsx-dev-runtime/main.d.ts",
      "import": "./build/jsx-dev-runtime/main.js",
      "require": "./build/jsx-dev-runtime/main.js"
    }
  },
  "bin": {
    "qrill": "build/bin.sh"
  },
  "scripts": {
    "clean": "rm -rf build dist package.tgz qrilljs-*.tgz",
    "build-release": "biome check --write ./src ./site ./test && tsc && tsup --config tsup.config.ts --publicDir",
    "build": "biome check --write ./src ./site ./test && tsc && tsup --config tsup.debug.config.ts --publicDir",
    "node-dev": "concurrently \"tsc --watch\" \"node --watch --import=tsx script/bin.ts dev\"",
    "node-build": "tsc && node --import=tsx script/bin.ts build",
    "bun-dev": "concurrently \"tsc --watch\" \"bun --hot script/bin.ts dev\"",
    "bun-build": "tsc && bun script/bin.ts build",
    "deno-dev": "deno check ./site/**/*.{ts,tsx} && deno -A script/bin.ts dev",
    "deno-build": "deno check ./site/**/*.{ts,tsx} && deno -A script/bin.ts build",
    "check": "biome check --write ./src ./site ./test",
    "pack": "npm pack"
  },
  "author": "osawa naotaka",
  "license": "MIT",
  "homepage": "https://github.com/osawa-naotaka/qrilljs",
  "bugs": {
    "url": "https://github.com/osawa-naotaka/qrilljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osawa-naotaka/qrilljs.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "@types/deno": "^2.7.0",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.1",
    "staticseek": "^2.7.1",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/plugin-virtual": "^3.0.2",
    "@types/jsdom": "^28.0.3",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.7",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-export-toc": "^0.1.0-alpha.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rollup": "^4.60.4",
    "svg2woff2": "^0.3.5",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "valibot": "^1.4.1",
    "ws": "^8.21.0"
  }
}

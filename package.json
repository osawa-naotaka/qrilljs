{
  "name": "qrilljs",
  "version": "0.1.0-alpha.29",
  "description": "lightweight static site generator for typescript",
  "type": "module",
  "main": "build/client/main.js",
  "exports": {
    "./core": {
      "types": "./build/core/main.d.ts",
      "import": "./build/core/main.js",
      "require": "./build/core/main.js"
    },
    "./server": {
      "types": "./build/server/main.d.ts",
      "import": "./build/server/main.js",
      "require": "./build/server/main.js"
    },
    "./jsx-runtime": {
      "types": "./build/jsx-runtime/main.d.ts",
      "import": "./build/jsx-runtime/main.js",
      "require": "./build/jsx-runtime/main.js"
    },
    "./jsx-dev-runtime": {
      "types": "./build/jsx-dev-runtime/main.d.ts",
      "import": "./build/jsx-dev-runtime/main.js",
      "require": "./build/jsx-dev-runtime/main.js"
    }
  },
  "bin": {
    "qrill": "build/bin.js"
  },
  "scripts": {
    "clean": "rm -rf build dist package.tgz qrilljs-*.tgz",
    "build-release": "biome check --write ./src ./site ./test && tsc && tsup --config tsup.config.ts",
    "build": "biome check --write ./src ./site ./test && tsc && tsup --config tsup.debug.config.ts",
    "dev": "concurrently \"tsc --watch\" \"tsup --watch --config tsup.debug.config.ts\" \"bun --hot src/bin.ts dev\"",
    "node-dev": "concurrently \"tsc --watch\" \"tsup --watch --config tsup.debug.config.ts\" \"tsx watch --exclude './site/**/*' --clear-screen=false src/bin.ts dev\"",
    "node-build": "tsc && tsx src/bin.ts build",
    "bun-dev": "concurrently \"tsc --watch\" \"tsup --watch --config tsup.debug.config.ts\" \"bun --hot src/bin.ts dev\"",
    "bun-build": "tsc && bun src/bin.ts build",
    "deno-dev": "deno check ./site/**/*.{ts,tsx} && deno run -A src/bin.ts dev",
    "deno-build": "deno check ./site/**/*.{ts,tsx} && deno run -A src/bin.ts build",
    "check": "biome check --write ./src ./site ./test",
    "pack": "npm pack"
  },
  "author": "osawa naotaka",
  "license": "MIT",
  "homepage": "https://github.com/osawa-naotaka/qrilljs",
  "bugs": {
    "url": "https://github.com/osawa-naotaka/qrilljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osawa-naotaka/qrilljs.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@types/bun": "^1.3.0",
    "@types/deno": "^2.5.0",
    "@types/node": "^24.8.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "staticseek": "^2.7.1",
    "tsup": "^8.5.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@rollup/plugin-virtual": "^3.0.2",
    "@types/jsdom": "^27.0.0",
    "chokidar": "^4.0.3",
    "dompurify": "^3.3.0",
    "esbuild": "^0.25.11",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "jsdom": "^27.0.1",
    "rehype-prism-plus": "^2.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-export-toc": "^0.1.0-alpha.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rollup": "^4.52.5",
    "svg2woff2": "^0.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "valibot": "^1.1.0",
    "ws": "^8.18.3"
  }
}
